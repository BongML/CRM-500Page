# Chép file này thành .env rồi điền giá trị thật. .env không bao giờ được commit.

# --- Cơ sở dữ liệu (PostgreSQL, ví dụ Neon) ---
# Chuỗi POOLED — app dùng lúc chạy. Với Neon, hostname có "-pooler".
# Giữ nguyên đuôi tham số: pgbouncer=true giúp Prisma hoạt động đúng sau PgBouncer,
# connection_limit giới hạn số kết nối mỗi instance serverless mở ra.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20"

# Chuỗi DIRECT — chỉ dùng để chạy migration (PgBouncer không chạy được DDL trong
# transaction). Giống chuỗi trên nhưng bỏ "-pooler" và bỏ các tham số pool.
# Thiếu biến này thì scripts/migrate.mjs tự suy ra từ chuỗi pooled.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Phiên đăng nhập ---
# Khóa ký cookie phiên. BẮT BUỘC ở production — thiếu là app từ chối chạy.
# Sinh khóa mới: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Đổi khóa = đăng xuất toàn bộ tài khoản.
CRM_SESSION_SECRET=""

# --- Tài khoản tổng (admin) ---
# Tài khoản nhìn thấy và quản lý dữ liệu của MỌI người dùng. App tự dựng nó ở
# lần đăng nhập đầu tiên bằng đúng email dưới đây, nên không cần chạy script.
# Không đặt thì mặc định là admin@crm.vn / Admin@123456 — ĐỔI TRƯỚC KHI CHẠY THẬT.
CRM_ADMIN_EMAIL="admin@crm.vn"
CRM_ADMIN_PASSWORD=""

# --- Tùy chọn ---
# Ngưỡng % bình luận tiêu cực để tô cảnh báo trong bảng top content (mặc định 5).
CRM_NEG_THRESHOLD="5"
